# Track only our own code + docs; WordPress core, third-party plugins/themes and uploads are reproducible.
/public/*
!/public/wp-content/
/public/wp-content/*
!/public/wp-content/themes/
/public/wp-content/themes/*
!/public/wp-content/themes/nafha-child/
!/public/wp-content/plugins/
/public/wp-content/plugins/*
!/public/wp-content/plugins/nafha-core/
/tools/wp-cli.phar
.local-credentials.txt
*.log

/tools/node_modules/
/tools/images/out/
!/public/wp-content/mu-plugins/
/public/wp-content/mu-plugins/*
!/public/wp-content/mu-plugins/nafha-local-mail.php

/tools/reports/
